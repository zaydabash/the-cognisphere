# The Cognisphere — backend environment configuration
# Copy to .env and adjust as needed: cp backend/.env.example backend/.env

# Runtime environment: "development" (open CORS) or "production" (restricted CORS)
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins (used when ENVIRONMENT=production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional API-key authentication.
# Set REQUIRE_AUTH=true and provide API_KEY to require a Bearer token on
# state-changing endpoints. Leave REQUIRE_AUTH=false for open local use.
REQUIRE_AUTH=false
API_KEY=

# Port the FastAPI server listens on
PORT=8000

# Simulation defaults (can also be overridden per-request via the API)
AGENTS=300
SEED=42
TICK_MS=100

# LLM adapter: "mock" (no network, deterministic) or "openai"
LLM_MODE=mock
# Required only when LLM_MODE=openai
OPENAI_API_KEY=

# Memory / vector backends
MEM_BACKEND=networkx
VEC_BACKEND=faiss
